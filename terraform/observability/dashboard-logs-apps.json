        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki_ds"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki_ds"
          },
          "expr": "sum(count_over_time({namespace=\"apps\"}[15m]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
